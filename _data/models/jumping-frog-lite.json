          "from": 0.55,
          "to": 1
        },
        {
          "flap": "top-r",
          "angle": 0,
          "from": 0.55,
          "to": 1
        }
      ]
    },
    {
      "label": "Turn it back over. Push the sides in and fold the top down so you get a triangle on top of a rectangle.",
      "dur": 1.15,
      "flip": 0,
      "moves": [
        {
          "flap": "top-l",
          "angle": 178
        },
        {
          "flap": "top-r",
          "angle": -178
        },
        {
          "flap": "diag-l",
          "angle": 155
        },
        {
          "flap": "diag-r",
          "angle": -155
        }
      ]
    },
    {
      "label": "Fold the triangle's two flaps up to make the front legs.",
      "dur": 0.9,
      "moves": [
        {
          "flap": "diag-l",
          "angle": 55
        },
        {
          "flap": "diag-r",
          "angle": -55
        }
      ]
    },
    {
      "label": "Fold the sides of the rectangle in to the middle line.",
      "dur": 0.9,
      "moves": [
        {
          "flap": "hip-l",
          "angle": 178
        },
        {
          "flap": "hip-r",
          "angle": -178
        },
        {
          "flap": "side-l",
          "angle": 178
        },
        {
          "flap": "side-r",
          "angle": -178
        }
      ]
    },
    {
      "label": "Fold the bottom edge up to the bottom of the triangle.",
      "dur": 0.85,
      "moves": [
        {
          "flap": "lower",
          "angle": -175
        }
      ]
    },
    {
      "label": "Fold the bottom corners out to make the back legs.",
      "dur": 0.85,
      "moves": [
        {
          "flap": "leg-l",
          "angle": -70
        },
        {
          "flap": "leg-r",
          "angle": 70
        }
      ]
    },
    {
      "label": "Fold the bottom half up, then fold it back down in half to make a zigzag spring.",
      "dur": 1.15,
      "moves": [
        {
          "flap": "spring",
          "angle": -158,
          "from": 0,
          "to": 0.48
        },
        {
          "flap": "lower",
          "angle": 55,
          "from": 0.52,
          "to": 1
        }
      ]
    },
    {
      "label": "Turn it over. Press the back and let go to jump!",
      "dur": 0.95,
      "flip": 180,
      "moves": [
        {
          "flap": "lower",
          "angle": 110,
          "from": 0,
          "to": 0.42
        },
        {
          "flap": "lower",
          "angle": 55,
          "from": 0.58,
          "to": 1
        }
      ]
