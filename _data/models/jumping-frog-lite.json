  "steps": [
    {
      "label": "Fold the square in half and cut along the fold. You'll use one rectangle, held tall.",
      "dur": 0.85,
      "moves": [
        {
          "flap": "scrap-l",
          "angle": -168
        },
        {
          "flap": "scrap-r",
          "angle": 168
        }
      ]
    },
    {
      "label": "Fold the top edge across to each side edge to make two diagonal creases, then unfold.",
      "dur": 0.95,
      "moves": [
        {
          "flap": "diag-l",
          "angle": 165,
          "from": 0,
          "to": 0.28
        },
        {
          "flap": "diag-l",
          "angle": 0,
          "from": 0.28,
          "to": 0.5
        },
        {
          "flap": "diag-r",
          "angle": -165,
          "from": 0.5,
          "to": 0.75
        },
        {
          "flap": "diag-r",
          "angle": 0,
          "from": 0.75,
          "to": 1
        }
      ]
    },
    {
      "label": "Turn it over. Fold the top edge down across where the diagonals cross, then unfold.",
      "dur": 0.95,
      "flip": 180,
      "moves": [
        {
          "flap": "top-l",
          "angle": 175,
          "from": 0,
          "to": 0.35
        },
        {
          "flap": "top-r",
